# Copy to .env.local — never commit real values.
# ARC is virtual. These keys are for provider APIs only.

# Paystack (card + Nigerian bank transfer). Webhooks are HMAC-SHA512
# of the raw body using PAYSTACK_SECRET_KEY — Paystack does not use a
# separate webhook secret.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Unused by Paystack; listed for ops checklists. Leave empty.
PAYSTACK_WEBHOOK_SECRET=

# Hosted crypto processor — not wired in Checkpoint 6B.
CRYPTO_PROVIDER_API_KEY=
CRYPTO_PROVIDER_WEBHOOK_SECRET=

# Public origin for Paystack callback_url (no /wallet UI in 6B).
ARENA_PUBLIC_BASE_URL=http://localhost:3000

# Force the in-process mock adapter (local non-production only).
# Ignored when NODE_ENV=production. Never processes real money.
# ARENA_PAYMENT_PROVIDER=mock
# MOCK_WEBHOOK_SECRET=  # test/dev only; ignored in production
